<?php
// Database connection
$conn = mysqli_connect("localhost", "root", "", "college");
if (!$conn) {
    die("Connection failed: " . mysqli_connect_error());
}

// Check if CR_number is passed in the URL parameter
if (isset($_GET['cr_number'])) {
    $crNumber = $_GET['cr_number'];
} else {
    // If CR_number is not passed, fetch the most recent CR_number from the database
    $sql = "SELECT * FROM admission ORDER BY CR_number DESC LIMIT 1"; // assuming 'id' is the primary key column
    $result = mysqli_query($conn, $sql);

    // Check if any data is returned
    if ($result && mysqli_num_rows($result) > 0) {
        $row = mysqli_fetch_assoc($result);
        $crNumber = $row['CR_number'];
        $Name= $row['Student_Name'];
        $father_name= $row['Father_Name'];
        $phone_number= $row['Phone_number'];
        $Address= $row['Address'];
        $DOB= $row['DOB'];
        $Gender= $row['Gender'];
        $Courses= $row['Courses'];
        
    } else {
        // If no data is found, set CR_number to 'N/A'
        $crNumber = 'N/A';
    }
}

// Close the database connection
mysqli_close($conn);
?>

