<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admission</title>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <style>
        *{
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: sans-serif;
        }
        body{
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background: silver;
            padding: 20px;
        }
        .container{
            position: relative;
            max-width: 700px;
            width: 100%;
            background: white;
            padding: 25px;
            border-radius: 8px;
            box-shadow: 0 0 15px black;
        }
        .container header{
            font-size: 1.5rem;
            color:red;
            font-weight: 500;
            text-align: center;
            text-decoration: underline;
        }
        .container .form{
            margin-top: 30px;
        }
        .form .input-box{
            width: 100%;
            margin-top: 20px;
        }
        .input-box label{
            color:black;
        }
        .form .input-box input{
            position: relative;
            height: 50px;
            width: 100%;
            outline: none;
            border: 1px solid #ddd;
            border-radius: 6px;
            padding: 0 15px;
            font-size: 1rem;
            color:rgb(99, 92, 92);
            margin-top: 8px;
        }
        .form .column{
            display: flex;
            column-gap: 15px;
        }
        .form .gender-option{
            display: flex;
            align-items: center;
            column-gap: 5px;
        }
        #btn{
            width: 100%;
            height: 50px;
            border-radius: 40px;
            border: none;
            font-size: 1.5em;
            text-transform: uppercase;
            font-weight: 600;
            margin: 10px 0;
            transition: 0.5s;
        }
        #btn:hover{
            background-color: rgba(0, 0, 0, 0.3);
            color:white;

        }
    </style>
</head>
<body>
    <section class="container">
        <header>Admisssion Form</header>
        <form action="insertadmission.php" class="form" method="post">
            <div class="input-box">
                <label>Student Name</label>
                <input type="text" placeholder="Enter Full Name " name="Student_Name" required>
            </div>
            <div class="input-box">
                <label>Father Name</label>
                <input type="text" placeholder="Enter Father Name " name="Father_Name" required>
            </div>
            <div class="column">
                <div class="input-box">
                    <label>Phone Number</label>
                    <input type="number" placeholder="Enter Phone Number " name="Phone_number" required>
                </div>

                <div class="column">
                    <div class="input-box">
                        <label>DOB</label>
                        <input type="date" placeholder="Enter DOB" name="DOB" required>
                    </div>
                </div>
            </div>
            <div class="input-box">
                <label>Address</label>
                <input type="text" placeholder="Enter Address " name="Address" required>
            </div>
            <br>
            <div class="gender-box">
              <h3>Gender</h3>
                <div class="Gender-option">
                <div class="Gender">
                    <input type="radio" id="male" name="Gender" value="M" required>
                    <label for="male">Male</label>
                    <input type="radio" id="female" name="Gender" value="F">
                    <label for="female">Female</label>
                </div>
                 <div class="input-box">
                    <h3>Courses</h3>
                    <select name="Courses" id="courses" required>
                       
                    </select>
                </div>
            </div>
            <input type="submit" value="submit" id="btn" name="submit">
        </form>
    </section>
    <script>
        // Load courses from localStorage and populate the dropdown
        window.onload = function() {
            let courses = JSON.parse(localStorage.getItem('courses')) || [];

            // Get the select element for courses
            let courseSelect = document.getElementById("courses");

            // Add default option for the course selection
            let defaultOption = document.createElement("option");
            defaultOption.value = "";
            defaultOption.textContent = "SELECT COURSE";
            courseSelect.appendChild(defaultOption);

            // Add each course from localStorage to the dropdown
            courses.forEach(function(course) {
                let option = document.createElement("option");
                option.value = course;
                option.textContent = course;
                courseSelect.appendChild(option);
            });
        };
    </script>
</body>
</html>